{
  "_comment": "Rectified Flow JAX/TPU — Single-file config. Edit here, run script.",
  "paths": {
    "dataset_root": "/kaggle/input/datasets/hamdallak/the-iqothnccd-lung-cancer-dataset/The IQ-OTHNCCD lung cancer dataset",
    "output_dir": "/kaggle/working/rf_output",
    "synthetic_dir": "/kaggle/working/synthetic_images_rf",
    "resume_checkpoint": null,
    "pytorch_checkpoint": null
  },
  "dataset": {
    "classes": [
      "Bengin cases",
      "Malignant cases",
      "Normal cases"
    ],
    "class_to_idx": {
      "Bengin cases": 0,
      "Malignant cases": 1,
      "Normal cases": 2
    },
    "idx_to_class": {
      "0": "Benign",
      "1": "Malignant",
      "2": "Normal"
    },
    "num_classes": 3,
    "train_ratio": 0.70,
    "val_ratio": 0.15
  },
  "image": {
    "size": 224,
    "channels": 1
  },
  "augmentation": {
    "enabled": true,
    "horizontal_flip": {
      "enabled": true,
      "p": 0.5
    },
    "rotation": {
      "enabled": true,
      "limit": 15,
      "p": 0.5,
      "border_mode": 0
    },
    "elastic": {
      "enabled": true,
      "alpha": 120,
      "sigma_ratio": 0.05,
      "p": 0.3,
      "border_mode": 0
    },
    "clahe": {
      "enabled": true,
      "clip_limit": 2.0,
      "tile_grid": [
        8,
        8
      ],
      "p": 0.3
    },
    "brightness_contrast": {
      "enabled": true,
      "brightness_limit": 0.1,
      "contrast_limit": 0.1,
      "p": 0.3
    },
    "gauss_noise": {
      "enabled": true,
      "p": 0.2
    },
    "online_flip": {
      "enabled": true,
      "p": 0.5,
      "_comment": "JAX random flip inside train_step"
    }
  },
  "model": {
    "base_channels": 128,
    "channel_multipliers": [
      1,
      2,
      4,
      8
    ],
    "time_emb_dim": 256,
    "class_emb_dim": 256,
    "attention_resolutions": [
      2,
      -1
    ],
    "num_groups_norm": 8,
    "dropout_rate": 0.1,
    "dropout_deterministic": true,
    "_comment": "channel_multipliers: encoder stages. attention_resolutions: indices where SelfAttention is used (2=enc3, -1=bottleneck)"
  },
  "flow": {
    "sigma_min": 1e-4,
    "timestep_sampling": "logit_normal",
    "logit_normal_mean": 0.0,
    "logit_normal_std": 1.0,
    "cfg_dropout_rate": 0.1
  },
  "training": {
    "epochs": 3000,
    "per_device_batch": 3,
    "learning_rate": 1.5e-4,
    "weight_decay": 1e-4,
    "grad_clip_norm": 1.0,
    "ema_decay": 0.9999,
    "lr_schedule": "cosine_decay",
    "lr_warmup_steps": 0,
    "lr_end_factor": 0.0,
    "seed": 42,
    "_comment": "lr_schedule options: cosine_decay, warmup_cosine, constant"
  },
  "checkpointing": {
    "save_every": 100,
    "sample_every": 100,
    "num_samples_per_class": 4,
    "log_every": 1,
    "_comment": "save_every/sample_every in epochs. Set sample_every high to reduce overhead."
  },
  "generation": {
    "euler_steps": 50,
    "cfg_scale": 4.0,
    "num_synthetic_benign": 300,
    "num_synthetic_malignant": 0,
    "num_synthetic_normal": 100,
    "gen_batch_size": 16
  },
  "runtime": {
    "max_training_hours": 7.5,
    "generation_budget_min": 30,
    "use_wandb": true,
    "wandb_project": "ct-rectified-flow",
    "wandb_run_name_prefix": "rf-JAX"
  }
}